---
import Base from './Base.astro';
import '../styles/web-of-people.css';
import WebSubnav from '../components/WebSubnav.astro';
import { data } from '../lib/web/data';

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const {
  title,
  description = 'An interactive web of the people in the Cardinal story. Every fact cites the repository.',
  current = '',
} = Astro.props;
const full = title === 'Web of People' ? title : `${title} · Web of People`;
const c = data.ds.meta.counts;
---

<Base title={full} description={description}>
  <article class="doc wide wop-shell">
    <WebSubnav current={current} />
    <slot />
    <p class="bill wop-foot">
      {c.people} people, {c.events} events, {c.sources} repository files and {data.ds.webSources?.length ?? 0} external
      pages as sources. Portraits are public-domain or Creative Commons unless noted on the profile.
    </p>
  </article>
</Base>