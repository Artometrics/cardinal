---
import Base from '../../../layouts/Base.astro';
import NotesSubnav from '../../../components/NotesSubnav.astro';
import { getNote, getNotes } from '../../../lib/research';
import { renderMarkdown } from '../../../lib/render';

export function getStaticPaths() {
  return getNotes().map((note) => ({ params: { slug: note.slug } }));
}

const note = getNote(Astro.params.slug);
const html = await renderMarkdown(note.markdown);
---

<Base title={note.book || note.title} description={note.citationScheme || note.title}>
  <article class="doc">
    <h1 class="page-title">{note.book || note.title}</h1>
    {note.citationScheme && <p class="meta">{note.citationScheme}</p>}
    <NotesSubnav section="log" current="notes" />
    {
      note.images.length > 0 && (
        <section>
          <h2 class="group-label">Page images</h2>
          <div class="shot-grid">
            {note.images.map((image) => (
              <figure>
                <img src={image.src} alt={`Page ${image.page}`} />
                <figcaption>p. {image.page}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }
    <div class="prose" set:html={html} />
    <p class="bill">Verbatim close-reading notes. Page images appear only when a page cited in these notes was captured.</p>
  </article>
</Base>
